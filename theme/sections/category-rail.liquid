{%- comment -%}
  sections/category-rail.liquid
  Full-bleed horizontal rail of category cards. Cards bleed off both edges
  so the row reads as scrollable. Label sits on the image, bottom-left.
  Replaces the old "Choose your cloth" grid.
{%- endcomment -%}

{%- liquid
  # asset_url cannot report a file's width, so a theme asset gets no srcset
  # unless we already know what was generated for it. These are the six
  # category photographs the shop ships with; anything else the client types
  # into the fallback box still renders, just as a single src.
  assign v_420_860 = 'men-unstitched,men-shawls,women-shawls' | split: ','
  assign v_900 = 'women-unstitched,bridal,lada-waistcoats' | split: ','
-%}

{%- comment -%}
  The real slot, read off .ccard in kj-v2.css: clamp(210px,62vw,300px), and
  clamp(240px,34vw,300px) from 700px up. The breakpoints below are where
  those clamps change hands (62vw passes 210px at 340px and 300px at 485px;
  34vw passes 300px at 882px). A flat "22vw" on a 1920px screen claimed a
  422px box for a card that is never wider than 300px, so the browser pulled
  the 900w file onto every tile.
{%- endcomment -%}
{%- capture card_sizes -%}(min-width:882px) 300px, (min-width:706px) 34vw, (min-width:485px) 300px, (min-width:340px) 62vw, 210px{%- endcapture -%}

<section class="crail" aria-labelledby="crail-{{ section.id }}">
  {%- if section.settings.heading != blank -%}
    <div class="wrap crail__head">
      <div>
        <h2 id="crail-{{ section.id }}" class="crail__h">{{ section.settings.heading }}</h2>
        {%- if section.settings.sub != blank -%}<p class="crail__sub">{{ section.settings.sub }}</p>{%- endif -%}
      </div>
      {%- if section.settings.link != blank -%}
        <a class="more" href="{{ section.settings.link }}">{{ section.settings.link_label | default: 'View all' }}</a>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="crail__track" data-rail>
    {%- for block in section.blocks -%}
      <a class="ccard" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
        <span class="ccard__media">
          {%- comment -%}
            alt is empty on purpose. The label below is inside this same
            link, so a described image would make the link announce the
            category twice: "Gents Unstitched, Gents Unstitched, link".
            The photograph carries no information the label does not.
          {%- endcomment -%}
          {%- if block.settings.image -%}
            {%- comment -%}
              width/height are the picked image's own intrinsic size, so
              the browser reserves the right box. They were hardcoded
              900x1200 — 3:4 — against category art that is 4:5, which is
              a guaranteed layout shift on every tile.
            {%- endcomment -%}
            <img src="{{ block.settings.image | image_url: width: 900 }}"
                 srcset="{{ block.settings.image | image_url: width: 300 }} 300w,
                         {{ block.settings.image | image_url: width: 500 }} 500w,
                         {{ block.settings.image | image_url: width: 900 }} 900w"
                 sizes="{{ card_sizes }}"
                 width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}"
                 loading="lazy" decoding="async"
                 alt="">
          {%- elsif block.settings.asset_file != blank -%}
            {%- liquid
              assign base = block.settings.asset_file | split: '.' | first
              assign steps = ''
              if v_420_860 contains base
                assign steps = '420,860'
              elsif v_900 contains base
                assign steps = '900'
              endif
            -%}
            <img src="{{ block.settings.asset_file | asset_url }}"
                 {%- if steps != blank %}
                 srcset="{% assign step_list = steps | split: ',' %}{% for w in step_list %}{{ base | append: '-w' | append: w | append: '.webp' | asset_url }} {{ w }}w, {% endfor %}{{ block.settings.asset_file | asset_url }} 1000w"
                 sizes="{{ card_sizes }}"
                 {%- endif %}
                 width="1000" height="1250" loading="lazy" decoding="async"
                 alt="">
          {%- endif -%}
        </span>
        <span class="ccard__label">{{ block.settings.label }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Category rail",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "textarea", "id": "sub", "label": "Subtitle" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [
    { "type": "card", "name": "Card", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "asset_file", "label": "Or theme asset filename",
        "info": "One of the pictures already in the theme, for example men-unstitched.webp. Used only when no image is picked above." },
      { "type": "text", "id": "label", "label": "Label", "default": "Unstitched" },
      { "type": "url", "id": "link", "label": "Link" }
    ]}
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Category rail" }]
}
{% endschema %}
