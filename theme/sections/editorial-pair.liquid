{%- comment -%}
  sections/editorial-pair.liquid
  Two large editorial banners side by side, label centred on the image.
  Mirrors the READY TO WEAR / UNSTITCHED pair on the reference site.
{%- endcomment -%}
<section class="wrap epair">
  {%- for block in section.blocks limit: 2 -%}
    <a class="epair__item" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
      {%- if block.settings.image -%}
        <img src="{{ block.settings.image | image_url: width: 1400 }}"
             sizes="(min-width:900px) 46vw, 92vw" width="1400" height="900"
             loading="lazy" decoding="async"
             alt="{{ block.settings.image.alt | default: block.settings.label | escape }}">
      {%- elsif block.settings.asset_file != blank -%}
        <img src="{{ block.settings.asset_file | asset_url }}" width="1400" height="900"
             loading="lazy" decoding="async" alt="{{ block.settings.label | escape }}">
      {%- endif -%}
      <span class="epair__label">{{ block.settings.label }}</span>
    </a>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Editorial pair",
  "tag": "section",
  "blocks": [
    { "type": "item", "name": "Banner", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "asset_file", "label": "…or theme asset filename" },
      { "type": "text", "id": "label", "label": "Label", "default": "Unstitched" },
      { "type": "url", "id": "link", "label": "Link" }
    ]}
  ],
  "max_blocks": 2,
  "presets": [{ "name": "Editorial pair" }]
}
{% endschema %}
