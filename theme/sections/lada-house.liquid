{%- comment -%}
  Physical proof, at the bottom of the page.

  A named workshop and a door you can walk through, as selectable text
  — not a screenshot of an address and not a map embed. A new label
  nobody has heard of is asking for a courier order; the answer to "who
  are these people" has to be copyable, dialable and searchable.

  Hours and the landline have NO defaults on purpose. Inventing opening
  hours for a real shop on Civil Quarters Road would send someone to a
  closed door, so each line renders only once it is filled in. The
  address and the founding year are the two facts already on file.

  Two routes split by intent, because "orders" and "does this fit me"
  are answered by different people. Only one number is on file; until
  the second is supplied both routes dial it and the pre-filled message
  carries the intent instead.
{%- endcomment -%}
{%- liquid
  assign wa_orders = section.settings.whatsapp_orders | default: '923019090590'
  assign wa_fit = section.settings.whatsapp_fit | default: wa_orders
  assign t_orders = section.settings.orders_text | default: 'I would like to place an order with Khan Jee.'
  assign t_fit = section.settings.fit_text | default: 'I have a question about Lada measurement and fit.'
-%}
<section class="lada lada__house" id="lada-house">
  <div class="lada__wrap lada__sec">
    <p class="lada__kicker">{{ section.settings.kicker | default: 'The house' }}</p>
    <h2 class="lada__h2">{{ section.settings.heading | default: 'A door you can walk through' }}</h2>

    <div class="lada__house-grid">
      <div class="lada__house-copy">
        <address class="lada__address">
          {{ section.settings.address | default: 'Khan Jee Center, Civil Quarters Road, Sheikhupura.' }}<br>
          {{ section.settings.established | default: 'Est. 1978.' }}
        </address>

        <dl class="lada__house-facts">
          {%- if section.settings.hours != blank -%}
            <div><dt>Open</dt><dd>{{ section.settings.hours }}</dd></div>
          {%- endif -%}
          {%- if section.settings.landline != blank -%}
            <div>
              <dt>Telephone</dt>
              <dd><a href="tel:{{ section.settings.landline | remove: ' ' | remove: '-' }}">{{ section.settings.landline }}</a></dd>
            </div>
          {%- endif -%}
        </dl>
      </div>

      {%- if section.settings.image or section.settings.asset_file != blank -%}
        <figure class="lada__house-media">
          {%- if section.settings.image -%}
            {%- assign hw = section.settings.image.width -%}
            {%- if hw > 1600 %}{% assign hw = 1600 %}{% endif -%}
            <img src="{{ section.settings.image | image_url: width: hw }}"
                 srcset="{{ section.settings.image | image_url: width: 700 }} 700w,
                         {{ section.settings.image | image_url: width: 1100 }} 1100w,
                         {{ section.settings.image | image_url: width: hw }} {{ hw }}w"
                 sizes="(min-width:900px) 46vw, 100vw"
                 width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}"
                 loading="lazy" decoding="async"
                 alt="{{ section.settings.image.alt | default: 'The Khan Jee Center shopfront on Civil Quarters Road, Sheikhupura' | escape }}">
          {%- else -%}
            <img src="{{ section.settings.asset_file | asset_url }}"
                 width="1600" height="1067" loading="lazy" decoding="async"
                 alt="{{ section.settings.image_alt | default: 'The Khan Jee Center shopfront on Civil Quarters Road, Sheikhupura' | escape }}">
          {%- endif -%}
        </figure>
      {%- endif -%}
    </div>

    <div class="lada__routes">
      <div class="lada__route">
        <p class="lada__route-h">{{ section.settings.orders_title | default: 'Orders and reservations' }}</p>
        <a class="btn-lada" href="https://wa.me/{{ wa_orders }}?text={{ t_orders | url_encode }}"
           target="_blank" rel="noopener">
          {{ section.settings.orders_label | default: 'Message us on WhatsApp' }}</a>
      </div>
      <div class="lada__route">
        <p class="lada__route-h">{{ section.settings.fit_title | default: 'Measurement and fit' }}</p>
        <a class="btn-lada btn-lada--ghost" href="https://wa.me/{{ wa_fit }}?text={{ t_fit | url_encode }}"
           target="_blank" rel="noopener">
          {{ section.settings.fit_label | default: 'Ask about your size' }}</a>
      </div>
    </div>
  </div>

  {%- comment -%}
    One launcher, on-register: champagne on ground, radius 0, 44px
    minimum. Third-party chat widgets are what put a teal bubble with a
    2px radius on HSY's otherwise strict black-and-white page; this is
    an anchor, so it cannot import a colour or a corner the page has
    not already agreed to.
  {%- endcomment -%}
  {%- if section.settings.show_launcher -%}
    <a class="lada__wa" href="https://wa.me/{{ wa_orders }}?text={{ t_orders | url_encode }}"
       target="_blank" rel="noopener"
       aria-label="{{ section.settings.launcher_label | default: 'Message Khan Jee on WhatsApp' | escape }}">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false">
        <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2Zm0 18.02h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.22 8.22 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23a8.23 8.23 0 0 1 8.24 8.24c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.18-.54.06-.25-.13-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.44.13-.15.17-.25.25-.42.09-.16.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.47c-.16 0-.43.06-.65.31-.23.25-.86.84-.86 2.05s.88 2.38 1 2.54c.13.17 1.74 2.65 4.21 3.71.59.26 1.05.41 1.4.52.59.19 1.13.16 1.55.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.1-.23-.16-.48-.28Z"/>
      </svg>
      <span>{{ section.settings.launcher_text | default: 'WhatsApp' }}</span>
    </a>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Lada house",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "address", "label": "Address" },
    { "type": "text", "id": "established", "label": "Established line" },
    { "type": "text", "id": "hours", "label": "Opening hours", "info": "NOT SET. Left blank deliberately — the line is hidden until real hours are supplied. Do not guess." },
    { "type": "text", "id": "landline", "label": "Landline", "info": "NOT SET. Hidden until supplied. Include the area code." },
    { "type": "header", "content": "Shopfront photograph" },
    { "type": "paragraph", "content": "Landscape, the shop from the street. Hidden until supplied." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "asset_file", "label": "…or theme asset filename" },
    { "type": "text", "id": "image_alt", "label": "Alt text", "info": "Used with the asset filename only" },
    { "type": "header", "content": "Orders and reservations" },
    { "type": "text", "id": "orders_title", "label": "Title" },
    { "type": "text", "id": "orders_label", "label": "Button" },
    { "type": "text", "id": "whatsapp_orders", "label": "WhatsApp number", "default": "923019090590" },
    { "type": "textarea", "id": "orders_text", "label": "Pre-filled message" },
    { "type": "header", "content": "Measurement and fit" },
    { "type": "text", "id": "fit_title", "label": "Title" },
    { "type": "text", "id": "fit_label", "label": "Button" },
    { "type": "text", "id": "whatsapp_fit", "label": "WhatsApp number", "info": "Leave blank to use the orders number." },
    { "type": "textarea", "id": "fit_text", "label": "Pre-filled message" },
    { "type": "header", "content": "Floating launcher" },
    { "type": "checkbox", "id": "show_launcher", "label": "Show the WhatsApp launcher", "default": true },
    { "type": "text", "id": "launcher_text", "label": "Launcher text" },
    { "type": "text", "id": "launcher_label", "label": "Launcher accessible name" }
  ],
  "presets": [{ "name": "Lada house" }]
}
{% endschema %}
