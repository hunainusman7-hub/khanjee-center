{%- comment -%}
  sections/hero-slideshow.liquid
  Full-bleed slideshow. Hiran Minar is slide one and is treated as a
  landscape photograph — it fills the frame instead of being cropped into
  a portrait panel. Autoplays, pauses on hover/focus, and stops entirely
  for anyone who prefers reduced motion.
{%- endcomment -%}

<section class="hs" data-hs data-autoplay="{{ section.settings.autoplay_seconds }}"
         aria-roledescription="carousel" aria-label="{{ section.settings.aria_label | default: 'Featured' | escape }}">
  <div class="hs__track">
    {%- for block in section.blocks -%}
      <div class="hs__slide{% if forloop.first %} is-active{% endif %}"
           data-hs-slide role="group" aria-roledescription="slide"
           aria-label="{{ forloop.index }} of {{ section.blocks.size }}"
           {% unless forloop.first %}aria-hidden="true"{% endunless %}
           {{ block.shopify_attributes }}>

        {%- if block.settings.image -%}
          <img class="hs__img" src="{{ block.settings.image | image_url: width: 2400 }}"
               srcset="{{ block.settings.image | image_url: width: 900 }} 900w,
                       {{ block.settings.image | image_url: width: 1600 }} 1600w,
                       {{ block.settings.image | image_url: width: 2400 }} 2400w"
               sizes="100vw" width="2400" height="1350"
               style="object-position:{{ block.settings.focal | default: 'center' }}"
               {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
               decoding="async" alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}">
        {%- elsif block.settings.asset_file != blank -%}
          <img class="hs__img" src="{{ block.settings.asset_file | asset_url }}"
               width="2400" height="1350"
               style="object-position:{{ block.settings.focal | default: 'center' }}"
               {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
               decoding="async" alt="{{ block.settings.heading | escape }}">
        {%- endif -%}

        <div class="hs__scrim" data-align="{{ block.settings.align }}"></div>

        <div class="hs__in" data-align="{{ block.settings.align }}">
          {%- if block.settings.eyebrow != blank -%}
            <p class="hs__eyebrow">{{ block.settings.eyebrow }}</p>
          {%- endif -%}
          {%- if block.settings.heading_mark == 'kj' or block.settings.heading_mark == 'lada' -%}
            {%- comment -%}
              The mark IS the heading on these slides — the client asked for the
              logo centred over Hiran Minar, and a wordmark under a duplicate
              text heading reads as a mistake. The <h2> stays so the document
              outline is intact; the mark carries the accessible name, so a
              screen reader still hears "Khan Jee" / "Lada" here.
            {%- endcomment -%}
            <h2 class="hs__title hs__title--mark hs__title--{{ block.settings.heading_mark }}">
              {%- render 'kj-mark', mark: block.settings.heading_mark, label: block.settings.heading -%}
            </h2>
          {%- else -%}
            <h2 class="hs__title">{{ block.settings.heading }}</h2>
          {%- endif -%}
          <div class="hs__rule"></div>
          {%- if block.settings.sub != blank -%}
            <p class="hs__sub">{{ block.settings.sub }}</p>
          {%- endif -%}
          {%- if block.settings.cta != blank -%}
            <a class="hs__btn" href="{{ block.settings.link | default: '#' }}">{{ block.settings.cta }}</a>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <button class="hs__arrow hs__arrow--prev" type="button" data-hs-prev aria-label="Previous slide">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M15 4 7 12l8 8"/></svg>
    </button>
    <button class="hs__arrow hs__arrow--next" type="button" data-hs-next aria-label="Next slide">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M9 4l8 8-8 8"/></svg>
    </button>

    <div class="hs__dots" role="tablist" aria-label="Slides">
      {%- for block in section.blocks -%}
        <button class="hs__dot{% if forloop.first %} is-active{% endif %}" type="button"
                data-hs-dot="{{ forloop.index0 }}" role="tab"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-label="{{ block.settings.heading | escape }}"><span></span></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero slideshow",
  "tag": "section",
  "settings": [
    { "type": "range", "id": "autoplay_seconds", "min": 0, "max": 12, "step": 1, "unit": "s",
      "label": "Autoplay interval", "default": 6, "info": "0 turns autoplay off" },
    { "type": "text", "id": "aria_label", "label": "Accessible label", "default": "Featured" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "asset_file", "label": "…or theme asset filename",
          "info": "e.g. hiran-minar-2560.jpg — used only when no image is picked" },
        { "type": "select", "id": "focal", "label": "Image focus", "default": "center",
          "options": [
            { "value": "center", "label": "Centre" },
            { "value": "center top", "label": "Top" },
            { "value": "center bottom", "label": "Bottom" }
          ]},
        { "type": "select", "id": "align", "label": "Text position", "default": "left",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "centre", "label": "Centre" }
          ]},
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Khan Jee" },
        { "type": "select", "id": "heading_mark", "label": "Show heading as a logo", "default": "none",
          "info": "Draws the brand mark instead of the heading text. The heading is still used as the mark's screen-reader label, so keep it filled in.",
          "options": [
            { "value": "none", "label": "Text heading" },
            { "value": "kj",   "label": "Khan Jee mark" },
            { "value": "lada", "label": "Lada wordmark" }
          ]},
        { "type": "textarea", "id": "sub", "label": "Subtitle" },
        { "type": "text", "id": "cta", "label": "Button label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Button link" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Hero slideshow" }]
}
{% endschema %}
