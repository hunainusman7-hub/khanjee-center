{%- comment -%}
  sections/brand-marquee.liquid
  Home-page brand strip. Two rows drift in opposite directions; kj-v2.js
  links their speed to the reader's scroll (faster on scroll, reversing on
  scroll-up) and eases them to a crawl on hover so they can be clicked.
  Every item is a real link to that brand's collection. Real logos where we
  hold the file, house wordmarks otherwise. Lists mirror brand-directory.liquid
  minus fabric types; keep the two in step.
{%- endcomment -%}

{%- liquid
  assign gents  = 'Dynasty,Pasha,Grace,Narkins,Shabbir,Shaffer,Sitara,Stallers,Chawla,Ghani & Sons,Ghazi Ilamdin,Bin Saeed,Barooque,Laaj,Puri,Rashid' | split: ','
  assign ladies = 'Alkaram,Asim Jofa,Crimson,Gulaal,Maria B,Bin Ilyas,Charizma,Glamour,Elan,Gul Ahmad,Emaan Adeel,Emblish,Khoobsoorat,Mushq,Noor,Zellbury,Rang Rasia,Ramshah,Razab,Sara,Lakhanee,Nur,Raessa,Sirine,Seren,Florent,Izinek,Jhora,Columkari' | split: ','
  assign bridal = 'Ayla Zahra,Zahra Shahjahan,Sobia Nazir,Shiza Hassan,Saira Rizwan,Saira Shakira,Sadia Noor,Sanum Saeed,Noor by Sadia,Noor e Fajar,Hussain Rehar,Rajbari,Shahista,Parishy,Zebtan' | split: ','
  # handle : file : intrinsic width : intrinsic height. The two numbers are
  # the logo file's own pixel size, read off the files in assets/. They used
  # to be a flat 140x38 on all 45 marks, and the real ratios run from 0.98:1
  # (Emaan Adeel) to 8.6:1 (Sobia Nazir), so the browser reserved the wrong
  # width for every one and the whole row jumped sideways as they arrived.
  # CSS still draws them: .bmq__item img is max-height:38px, width:auto, so
  # these attributes only decide the box held open before the file lands.
  # sections/brand-directory.liquid carries the same handle:file pairs but
  # not these two numbers, because its logos are drawn in a fixed-height
  # cell. Add a brand to one list and it has to be added to the other.
  assign logo_map = 'alkaram:alkaram.webp:309:96,asim-jofa:asim-jofa.webp:201:96,ayla-zahra:ayla-zahra.webp:96:96,bin-ilyas:bin-ilyas.webp:96:96,bin-saeed:bin-saeed.webp:324:96,charizma:charizma.svg:1597:223,chawla:chawla.webp:259:96,crimson:crimson.webp:128:96,dynasty:dynasty.svg:301:115,elan:elan.webp:403:96,emaan-adeel:emaan-adeel.webp:94:96,florent:florent.webp:240:96,ghani-sons:ghani-sons.webp:122:96,grace:grace.webp:240:96,gul-ahmad:gul-ahmad.webp:237:27,gulaal:gulaal.webp:250:68,hussain-rehar:hussain-rehar.webp:372:96,izinek:izinek.webp:223:96,jhora:jhora.webp:191:96,lakhanee:lakhanee.webp:327:96,maria-b:maria-b.svg:660:131,mushq:mushq.webp:365:96,narkins:narkins.webp:360:96,noor:noor.webp:137:96,noor-e-fajar:noor-e-fajar.webp:703:96,nur:nur.webp:96:96,parishy:parishy.webp:310:96,pasha:pasha.webp:260:110,puri:puri.webp:754:96,raessa:raessa.webp:280:96,rajbari:rajbari.webp:238:75,ramshah:ramshah.webp:200:64,rang-rasia:rang-rasia.webp:202:89,rashid:rashid.webp:252:96,razab:razab.webp:96:96,saira-rizwan:saira-rizwan.webp:242:96,saira-shakira:saira-shakira.webp:96:96,shabbir:shabbir.webp:96:96,shaffer:shaffer.webp:765:96,shahista:shaista.webp:324:96,sitara:sitara.webp:194:96,sobia-nazir:sobia-nazir.webp:686:80,zahra-shahjahan:zahra-shahjahan.webp:652:96,zebtan:zebtan.webp:711:96,zellbury:zellbury.webp:96:96' | split: ','
-%}

<section class="bmq" aria-labelledby="bmq-h">
  <div class="bmq__lead">
    <h2 id="bmq-h">{{ section.settings.heading | default: 'All brands under one roof' }}</h2>
    {%- if section.settings.sub != blank -%}<p>{{ section.settings.sub }}</p>{%- endif -%}
  </div>

  <div class="bmq__rows" data-bmq>
    {%- for r in (1..2) -%}
      <div class="bmq__row" data-bmq-row data-bmq-dir="{% if r == 1 %}-1{% else %}1{% endif %}">
        {%- liquid
          if r == 1
            assign groups = 'gents,bridal' | split: ','
          else
            assign groups = 'ladies' | split: ','
          endif
        -%}
        {%- for grp in groups -%}
          {%- liquid
            case grp
              when 'gents'
                assign list = gents
                assign prefix = 'gents-'
              when 'ladies'
                assign list = ladies
                assign prefix = 'ladies-'
              else
                assign list = bridal
                assign prefix = 'bridal-'
            endcase
          -%}
          {%- for brand in list -%}
            {%- liquid
              assign name = brand | strip
              assign handle = name | handleize
              assign logo_file = ''
              assign logo_w = ''
              assign logo_h = ''
              for pair in logo_map
                assign kv = pair | split: ':'
                if kv[0] == handle
                  assign logo_file = kv[1]
                  assign logo_w = kv[2]
                  assign logo_h = kv[3]
                endif
              endfor
            -%}
            {%- comment -%}
              Resolve the destination instead of assuming it. The strip
              lists every brand the shop carries, but a brand only has a
              collection once someone has created it — 52 of these 60
              handles did not exist, so 52 of the logos were links to a
              Shopify 404. This lands on the gender collection until the
              brand's own collection appears, and switches to it by
              itself the moment it does.
            {%- endcomment -%}
            {%- liquid
              assign brand_handle = prefix | append: handle
              case grp
                when 'gents'
                  assign fallback_handle = 'gents-unstitched'
                when 'ladies'
                  assign fallback_handle = 'ladies-unstitched'
                else
                  assign fallback_handle = 'bridal'
              endcase
              assign has_own = false
              if collections[brand_handle].id
                assign has_own = true
              endif
            -%}
            {%- capture brand_url -%}
              {%- render 'kj-collection-url', handle: brand_handle, fallback: fallback_handle, vendor: name -%}
            {%- endcapture -%}
            <a class="bmq__item" href="{{ brand_url | strip }}"
               aria-label="{% if has_own %}{{ name | escape }}, shop the brand{% else %}{{ name | escape }}, see what we have{% endif %}">
              {%- if logo_file != '' -%}
                <img src="{{ logo_file | asset_url }}" alt="{{ name | escape }}"
                     loading="lazy" decoding="async" width="{{ logo_w }}" height="{{ logo_h }}">
              {%- else -%}
                <span>{{ name }}</span>
              {%- endif -%}
            </a>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>

  <div class="bmq__more">
    <a class="more" href="{{ routes.root_url }}pages/brands">{{ section.settings.link_label | default: 'See every brand we stock' }}</a>
  </div>
</section>

{% schema %}
{
  "name": "Brand marquee",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "All brands under one roof" },
    { "type": "textarea", "id": "sub", "label": "Subtitle",
      "default": "Over sixty brands in the Sheikhupura shop, plus our own label, Lada, woven in-house." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "See every brand we stock" }
  ],
  "presets": [{ "name": "Brand marquee" }]
}
{% endschema %}
