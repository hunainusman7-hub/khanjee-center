{%- comment -%}
  sections/lada-band.liquid

  The homepage's one dark beat. Everything above it is the house of
  brands on white; this band is the label Khan Jee owns, so it changes
  register completely — dark ground, champagne mark, no product grid —
  and hands off to /pages/lada.

  index.json has referenced "lada-band" since the first build but the
  file never existed, so the last section of the homepage was rendering
  as nothing at all.

  The wordmark is the real Lada mark rather than type: the whole point
  of this band is that the label is ours.
{%- endcomment -%}

<section class="lband" aria-labelledby="lband-h">
  {%- if section.settings.image != blank or section.settings.asset_file != blank -%}
    {%- if section.settings.image -%}
      <img class="lband__bg" src="{{ section.settings.image | image_url: width: 2400 }}"
           srcset="{{ section.settings.image | image_url: width: 1200 }} 1200w,
                   {{ section.settings.image | image_url: width: 2400 }} 2400w"
           sizes="100vw" width="2400" height="1200" loading="lazy" decoding="async" alt="">
    {%- else -%}
      {%- liquid
        # A theme asset has no dimensions Liquid can read, so both the
        # candidate list and the width/height pair are declared rather
        # than measured, and both describe the file this section ships
        # with: lada-waistcoats.webp, 1000x1250, with a 900px variant
        # beside it in assets/.
        #
        # The srcset is gated on the filename because -w900 exists only
        # for that one file. Type any other asset name and this falls
        # back to the single candidate it had before, which is right:
        # a srcset pointing at a variant nobody generated is a 404 the
        # browser may well pick.
        #
        # The pair was 2400x1200 before, which is neither this file nor
        # any file in assets/. It never showed, because .lband__bg is
        # inset:0 / width:100% / height:100% / object-fit:cover over the
        # band, so the declared ratio sizes nothing; but a browser uses
        # it to reserve space before the bytes land, and reserving 2:1
        # for a 4:5 photograph is a wrong answer where a right one costs
        # the same.
        assign band_file = section.settings.asset_file
        assign band_w900 = ''
        if band_file == 'lada-waistcoats.webp'
          assign band_w900 = 'lada-waistcoats-w900.webp'
        endif
      -%}
      <img class="lband__bg" src="{{ band_file | asset_url }}"
           {%- if band_w900 != blank %}
           srcset="{{ band_w900 | asset_url }} 900w,
                   {{ band_file | asset_url }} 1000w"
           sizes="100vw"
           {%- endif %}
           width="1000" height="1250" loading="lazy" decoding="async" alt="">
    {%- endif -%}
  {%- endif -%}

  <div class="lband__in" data-reveal>
    <p class="lband__eyebrow">{{ section.settings.eyebrow | default: 'Our own label' }}</p>

    {%- assign mark_label = section.settings.heading | default: 'Lada by Khan Jee' -%}
    {%- comment -%}
      sizes restates .lband__mark's own clamp(210px, 38vw, 360px), so the
      band stops handing a phone the 600px mark for a 210px box.
    {%- endcomment -%}
    <h2 class="lband__mark" id="lband-h">
      {%- render 'kj-mark', mark: 'lada', label: mark_label,
                 sizes: '(min-width:948px) 360px, (min-width:553px) 38vw, 210px' -%}
    </h2>

    {%- comment -%}
      No byline element. The supplied lockup already reads "BY KHAN JEE"
      underneath the script, so setting it again as text printed it twice.
    {%- endcomment -%}

    {%- if section.settings.text != blank -%}
      <p class="lband__text">{{ section.settings.text }}</p>
    {%- endif -%}

    {%- if section.settings.cta != blank -%}
      <a class="lband__btn" href="{{ section.settings.link | default: '/pages/lada' }}">
        {{ section.settings.cta }}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Lada band",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "asset_file", "label": "Or theme asset filename",
      "default": "lada-waistcoats.webp",
      "info": "Used only when no image is picked" },
    { "type": "text", "id": "eyebrow", "label": "Small line above the heading", "default": "Our own label" },
    { "type": "text", "id": "heading", "label": "Wordmark label",
      "default": "Lada by Khan Jee",
      "info": "The wordmark is drawn, not typed. This is the name a screen reader reads out." },
    { "type": "textarea", "id": "text", "label": "Text",
      "default": "Waistcoats and coats we cut and stitch here, from cloth we weave ourselves. The only label in the shop that is ours from start to finish." },
    { "type": "text", "id": "cta", "label": "Button label", "default": "Enter Lada" },
    { "type": "url", "id": "link", "label": "Button link" }
  ],
  "presets": [{ "name": "Lada band" }]
}
{% endschema %}
