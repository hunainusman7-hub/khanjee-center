{%- comment -%}
  sections/main-collection.liquid
  Drives every brand / fabric / department collection page. Facets come from
  Shopify's native `collection.filters` (populated by Search & Discovery), so
  nothing here is hard-coded per brand.
{%- endcomment -%}

<div class="wrap">
  <nav class="crumb" aria-label="Breadcrumb">
    <a href="{{ routes.root_url }}">Home</a><i>/</i>
    <span aria-current="page">{{ collection.title }}</span>
  </nav>
</div>

<div class="wrap phead">
  <h1 class="ptitle">{{ collection.title }}</h1>
  {%- if collection.description != blank -%}
    <p class="psub">{{ collection.description }}</p>
  {%- endif -%}
</div>

<div class="wrap listing">
  {%- comment -%}
    The id is what the Filter button's aria-controls points at. It used to
    point at "filters", which is a class here and an id nowhere, so the
    relationship the button announced did not resolve to anything.
  {%- endcomment -%}
  <aside class="filters" id="CollectionFilters" data-filters aria-label="Filters">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:1rem">
      <h2 class="filters__h">Filter</h2>
      <button class="iconbtn filters__close" type="button" data-filter-close aria-label="Close filters">&times;</button>
    </div>

    {%- if collection.filters.size > 0 -%}
      <form id="FacetFilterForm">
        {%- for filter in collection.filters -%}
          <div class="filters__grp">
            <h3>{{ filter.label }}</h3>
            <div class="filters__list" data-facet>
              {%- if filter.type == 'price_range' -%}
                {%- comment -%}
                  onchange is the only thing that can apply a price here.
                  This form carries no submit button: each checkbox posts
                  itself on change, and "View results" is type="button"
                  because all it does is shut the drawer on a phone. HTML
                  only submits a button-less form on Enter when it holds
                  exactly one field that blocks implicit submission, and a
                  price range is two number inputs, so without this a
                  customer could type a range, press Enter, and watch
                  nothing happen. change fires when the value is committed,
                  which is Enter or leaving the field. Same idiom as
                  main-collection-lada.liquid.
                {%- endcomment -%}
                <div class="filters__price">
                  <input type="number" inputmode="numeric" name="{{ filter.min_value.param_name }}"
                         placeholder="Min" value="{{ filter.min_value.value }}" aria-label="Minimum price"
                         onchange="this.form.submit()">
                  <span aria-hidden="true">&ndash;</span>
                  <input type="number" inputmode="numeric" name="{{ filter.max_value.param_name }}"
                         placeholder="Max" value="{{ filter.max_value.value }}" aria-label="Maximum price"
                         onchange="this.form.submit()">
                </div>
              {%- else -%}
                {%- comment -%}
                  The selected state is a class, not aria-pressed.
                  aria-pressed only carries meaning on something with
                  role="button"; on a <label> nothing reads it, so it was
                  styling wearing an ARIA attribute's clothes. The real
                  control is the checkbox inside, and it already reports
                  checked, which is the same fact announced properly.
                {%- endcomment -%}
                {%- for value in filter.values -%}
                  <label class="chip{% if value.active %} is-on{% endif %}">
                    <input type="checkbox" class="vh" name="{{ value.param_name }}" value="{{ value.value }}"
                           {% if value.active %}checked{% endif %} onchange="this.form.submit()">
                    {{ value.label }} <span class="chip__n">{{ value.count }}</span>
                  </label>
                {%- endfor -%}
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </form>
    {%- endif -%}

    <div class="filters__done">
      <button class="btn" type="button" data-filter-close>View results</button>
    </div>
  </aside>

  <div>
    <div class="toolbar">
      <span class="toolbar__n num">{{ collection.products_count }} {{ collection.products_count | pluralize: 'product', 'products' }}</span>
      {%- if collection.filters.size > 0 -%}
        <button class="btn btn--ghost btn--sm toolbar__filter" type="button"
                data-filter-toggle aria-expanded="false" aria-controls="CollectionFilters">Filter</button>
      {%- endif -%}
    </div>

    {%- paginate collection.products by 24 -%}
      {%- if collection.products.size == 0 -%}
        <div class="empty">
          <h3>{{ collection.title }} arriving shortly</h3>
          <p>Stock is being photographed and listed now. The filters are live, so
             as soon as pieces are added they will appear here.</p>
        </div>
      {%- else -%}
        <div class="pgrid" style="margin-top:var(--s5)">
          {%- for product in collection.products -%}
            {% render 'product-card', product: product, index: forloop.index0 %}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="Pagination">
            {{ paginate | default_pagination }}
          </nav>
        {%- endif -%}
      {%- endif -%}
    {%- endpaginate -%}
  </div>

  <div class="scrim" data-scrim></div>
</div>

{% schema %}
{ "name": "Collection", "settings": [] }
{% endschema %}
