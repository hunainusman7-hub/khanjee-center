{%- comment -%}
  sections/product-carousel.liquid
  Heading + tab row + horizontal product rail with arrows and a scroll
  progress bar. Each tab is a block pointing at a collection.
{%- endcomment -%}

{%- comment -%}
  The rail cell is not a .pgrid cell, so the card is handed the rail's own
  slot. The wrapper below is clamp(200px,58vw,290px): 200px until the
  viewport reaches 345px, then 58vw, then flat 290px from 500px up. The
  grid's default sizes bottoms out at 46vw, which on a 500px phone asks for
  a 230px file to fill a 290px box, so every card in the rail arrived a
  quarter too small and upscaled.
{%- endcomment -%}
{%- capture rail_sizes -%}(min-width:500px) 290px, (min-width:345px) 58vw, 200px{%- endcapture -%}

<section class="pcar" data-pcar aria-labelledby="pcar-{{ section.id }}">
  <div class="wrap">
    <div class="shead">
      <div>
        <h2 id="pcar-{{ section.id }}" class="shead__t">{{ section.settings.heading | default: 'Most trending' }}</h2>
        {%- if section.settings.sub != blank -%}<p class="shead__s">{{ section.settings.sub }}</p>{%- endif -%}
      </div>
      <div class="shead__act">
        {%- if section.settings.link != blank -%}
          <a class="more" href="{{ section.settings.link }}">View all</a>
        {%- endif -%}
        <button class="rarrow" type="button" data-pcar-prev aria-label="Scroll left">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 4 7 12l8 8"/></svg>
        </button>
        <button class="rarrow" type="button" data-pcar-next aria-label="Scroll right">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 4l8 8-8 8"/></svg>
        </button>
      </div>
    </div>

    {%- if section.blocks.size > 1 -%}
      <div class="stabs" role="tablist">
        {%- for block in section.blocks -%}
          <button class="stab{% if forloop.first %} is-active{% endif %}" type="button" role="tab"
                  data-pcar-tab="{{ forloop.index0 }}"
                  aria-selected="{% if forloop.first %}true{% else %}false{% endif %}">
            {{ block.settings.label | default: collections[block.settings.collection].title }}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  {%- for block in section.blocks -%}
    {%- assign coll = collections[block.settings.collection] -%}
    <div class="pcar__panel{% unless forloop.first %} is-hidden{% endunless %}" data-pcar-panel="{{ forloop.index0 }}"
         {% unless forloop.first %}hidden{% endunless %} {{ block.shopify_attributes }}>
      {%- if coll != blank and coll.products.size > 0 -%}
        <div class="rail" data-pcar-rail>
          {%- for product in coll.products limit: section.settings.count -%}
            <div style="width:clamp(200px,58vw,290px)">
              {% render 'product-card', product: product, index: forloop.index0, card_sizes: rail_sizes %}
            </div>
          {%- endfor -%}
        </div>
        <div class="rail__bar" data-pcar-bar><span></span></div>
      {%- else -%}
        <div class="wrap"><div class="empty" style="margin-block:var(--s5)">
          <h3>Arriving shortly</h3>
          <p>These pieces are being photographed and listed now.</p>
        </div></div>
      {%- endif -%}
    </div>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Product carousel",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Most trending" },
    { "type": "textarea", "id": "sub", "label": "Subtitle" },
    { "type": "url", "id": "link", "label": "View all link" },
    { "type": "range", "id": "count", "min": 4, "max": 20, "step": 1, "label": "Products per tab", "default": 10 }
  ],
  "blocks": [
    { "type": "tab", "name": "Tab", "settings": [
      { "type": "text", "id": "label", "label": "Tab label" },
      { "type": "collection", "id": "collection", "label": "Collection" }
    ]}
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Product carousel" }]
}
{% endschema %}
