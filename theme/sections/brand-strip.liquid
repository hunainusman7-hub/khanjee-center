<section class="strip" aria-labelledby="strip-h">
  <div class="wrap strip__head">
    <h2 class="eyebrow" id="strip-h">{{ section.settings.heading }}</h2>
  </div>
  <div class="strip__track">
    <div class="strip__row" data-strip-row>
      {%- comment -%}
        EVERY LOGO DECLARES A BOX, and that is not only the usual
        layout-shift argument.

        site.js duplicates this row's markup to make the loop seamless
        and then reads scrollWidth to find out where to wrap. It reads
        it immediately, before a single logo has arrived. Images with
        no width and height measure as empty boxes at that moment, so
        the loop distance comes out short and the strip snaps back
        mid-run until the next resize event corrects it.

        A picked logo can state its own pixels. A theme asset cannot
        report its size to Liquid, so it states the nominal 160x46
        instead. Neither pair decides the final size: .strip__item
        pins the height (46px, 32px on a phone) and .strip__item img
        leaves the width auto, so this is reserved space and nothing
        more.

        The picked branch asks for 400 rather than 200 because a 46px
        tall logo is around 160 wide, and a 200px file is visibly soft
        on the retina screens most of this traffic is on.
      {%- endcomment -%}
      {% for block in section.blocks %}
        <span class="strip__item">
          {% if block.settings.logo %}
            <img src="{{ block.settings.logo | image_url: width: 400 }}"
                 srcset="{{ block.settings.logo | image_url: width: 200 }} 200w,
                         {{ block.settings.logo | image_url: width: 400 }} 400w"
                 sizes="160px"
                 width="{{ block.settings.logo.width }}" height="{{ block.settings.logo.height }}"
                 alt="{{ block.settings.name | escape }}" loading="lazy" decoding="async">
          {% elsif block.settings.asset_file != blank %}
            <img src="{{ block.settings.asset_file | asset_url }}"
                 width="160" height="46"
                 alt="{{ block.settings.name | escape }}" loading="lazy" decoding="async">
          {% else %}
            <span>{{ block.settings.name }}</span>
          {% endif %}
        </span>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Brand strip",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Twenty of Pakistan's labels, under one roof" }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "image_picker", "id": "logo", "label": "Logo (overrides asset file)" },
        { "type": "text", "id": "asset_file", "label": "Theme asset filename (fallback logo)" }
      ]
    }
  ],
  "presets": [
