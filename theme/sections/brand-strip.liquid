<section class="strip" aria-labelledby="strip-h">
  <div class="wrap strip__head">
    <h2 class="eyebrow" id="strip-h">{{ section.settings.heading }}</h2>
  </div>
  <div class="strip__track">
    <div class="strip__row" data-strip-row>
      {% for block in section.blocks %}
        <span class="strip__item">
          {% if block.settings.logo %}
            <img src="{{ block.settings.logo | image_url: width: 200 }}" alt="{{ block.settings.name | escape }}" decoding="async">
          {% elsif block.settings.asset_file != blank %}
            <img src="{{ block.settings.asset_file | asset_url }}" alt="{{ block.settings.name | escape }}" decoding="async">
          {% else %}
            <span>{{ block.settings.name }}</span>
          {% endif %}
        </span>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Brand strip",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Twenty of Pakistan's labels, under one roof" }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "image_picker", "id": "logo", "label": "Logo (overrides asset file)" },
        { "type": "text", "id": "asset_file", "label": "Theme asset filename (fallback logo)" }
      ]
    }
  ],
  "presets": [
    {
