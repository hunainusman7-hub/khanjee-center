<section class="lada lada__hero">
  {%- if section.settings.image -%}
    <img src="{{ section.settings.image | image_url: width: 2400 }}"
         srcset="{{ section.settings.image | image_url: width: 1200 }} 1200w,
                 {{ section.settings.image | image_url: width: 2400 }} 2400w"
         sizes="100vw" width="2400" height="1500" fetchpriority="high" decoding="async"
         alt="{{ section.settings.image.alt | default: 'Macro detail of a Lada weave' | escape }}">
  {%- else -%}
    <img src="{{ section.settings.asset_file | default: 'lada-waistcoats.jpg' | asset_url }}"
         width="2400" height="1500" fetchpriority="high" decoding="async"
         alt="Macro detail of a Lada weave">
  {%- endif -%}

  <div class="lada__wrap lada__hero-in">
    <p class="lada__eyebrow">{{ section.settings.eyebrow | default: 'Woven in-house · Khan Jee' }}</p>
    <h1 class="lada__wordmark">{{ section.settings.heading | default: 'Lada' }}</h1>
    <p class="lada__lede">{{ section.settings.lede | default: 'Spun, woven and finished under our own roof. The only cloth in this shop whose every thread we answer for.' }}</p>

    <div class="lada__ctas">
      <a class="btn-lada" href="{{ section.settings.primary_url | default: '#lada-collection' }}">
        {{ section.settings.primary_label | default: 'The unstitched flagship' }}</a>
      <a class="btn-lada btn-lada--ghost" href="{{ section.settings.secondary_url | default: '#lada-craft' }}">
        {{ section.settings.secondary_label | default: 'How it is made' }}</a>
    </div>

    <dl class="lada__seals">
      {%- for i in (1..3) -%}
        {%- liquid
          case i
            when 1
              assign t = section.settings.seal1_title | default: 'Woven in-house'
              assign d = section.settings.seal1_text | default: 'Every metre from our own looms.'
            when 2
              assign t = section.settings.seal2_title | default: 'Unconditional guarantee'
              assign d = section.settings.seal2_text | default: 'Replaced or refunded, no conditions.'
            when 3
              assign t = section.settings.seal3_title | default: 'Cut to measure'
              assign d = section.settings.seal3_text | default: '38R to 46R, and bespoke on request.'
          endcase
        -%}
        <div class="lada__seal"><dt>{{ t }}</dt><dd>{{ d }}</dd></div>
      {%- endfor -%}
    </dl>
  </div>
</section>

{% schema %}
{
  "name": "Lada hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Macro weave image" },
    { "type": "text", "id": "asset_file", "label": "…or theme asset filename", "default": "lada-waistcoats.jpg" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Woven in-house · Khan Jee" },
    { "type": "text", "id": "heading", "label": "Wordmark", "default": "Lada" },
    { "type": "textarea", "id": "lede", "label": "Lede" },
    { "type": "text", "id": "primary_label", "label": "Primary button" },
    { "type": "url",  "id": "primary_url", "label": "Primary link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button" },
    { "type": "url",  "id": "secondary_url", "label": "Secondary link" },
    { "type": "header", "content": "Seal of guarantee" },
    { "type": "text", "id": "seal1_title", "label": "Seal 1 title" },
    { "type": "text", "id": "seal1_text", "label": "Seal 1 text" },
    { "type": "text", "id": "seal2_title", "label": "Seal 2 title" },
    { "type": "text", "id": "seal2_text", "label": "Seal 2 text" },
    { "type": "text", "id": "seal3_title", "label": "Seal 3 title" },
    { "type": "text", "id": "seal3_text", "label": "Seal 3 text" }
  ],
  "presets": [{ "name": "Lada hero" }]
}
{% endschema %}
