{%- comment -%}
  The measurement service, sold as a service.

  It is Lada's single strongest differentiator and until now it was a
  paragraph inside a size table — reachable only by someone already
  scrolled to the sizing section and already worried about fit. Here it
  is a section, above the table, addressed to someone who has not yet
  thought to worry.

  No form and no scheduler. The funnel is WhatsApp; a form would add a
  step and an inbox nobody watches.

  The photograph is optional on purpose. `measure-service` has not been
  shot yet (see data/LADA-PHOTOGRAPHY-BRIEF.md, slot 9), and a section
  that breaks when its image is missing is a section that cannot ship
  before the shoot. With no image the copy column simply runs full
  width.
{%- endcomment -%}
{%- liquid
  assign wa = section.settings.whatsapp | default: '923019090590'
  assign wa_text = section.settings.whatsapp_text | default: 'I would like to send my measurements for a Lada piece.'
  assign has_image = false
  if section.settings.image or section.settings.asset_file != blank
    assign has_image = true
  endif
-%}
<section class="lada lada__measure" id="lada-measure">
  <div class="lada__wrap lada__sec">
    <div class="lada__measure-grid{% unless has_image %} lada__measure-grid--solo{% endunless %}">

      <div class="lada__measure-copy">
        <p class="lada__kicker">{{ section.settings.kicker | default: 'The service' }}</p>
        <h2 class="lada__h2">{{ section.settings.heading | default: 'Measured in the shop, at no charge' }}</h2>

        <ol class="lada__steps">
          {%- assign steps = section.settings.steps | default: 'Come in, or send your measurements on WhatsApp.|We cut to them, in our own workshop.|Collect from the shop, or we courier it to you.' | split: '|' -%}
          {%- for step in steps -%}
            <li><span class="n">{{ forloop.index | prepend: '0' }}</span><span>{{ step }}</span></li>
          {%- endfor -%}
        </ol>

        {%- comment -%}
          Lead time stated flat, not folded into an accordion. A
          customer deciding whether to order needs the number before
          they decide to look for it.
        {%- endcomment -%}
        <dl class="lada__lead">
          <div>
            <dt>{{ section.settings.lead1_label | default: 'Standard 38R–46R' }}</dt>
            <dd>{{ section.settings.lead1_value | default: 'Ready in 3 to 5 days' }}</dd>
          </div>
          <div>
            <dt>{{ section.settings.lead2_label | default: 'Cut to your measurement' }}</dt>
            <dd>{{ section.settings.lead2_value | default: '10 to 14 days' }}</dd>
          </div>
        </dl>
      </div>

      {%- if has_image -%}
        <figure class="lada__measure-media">
          {%- if section.settings.image -%}
            {%- assign mw = section.settings.image.width -%}
            {%- if mw > 1600 %}{% assign mw = 1600 %}{% endif -%}
            <img src="{{ section.settings.image | image_url: width: mw }}"
                 srcset="{{ section.settings.image | image_url: width: 700 }} 700w,
                         {{ section.settings.image | image_url: width: 1100 }} 1100w,
                         {{ section.settings.image | image_url: width: mw }} {{ mw }}w"
                 sizes="(min-width:900px) 46vw, 100vw"
                 width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}"
                 loading="lazy" decoding="async"
                 alt="{{ section.settings.image.alt | default: 'A customer being measured in the Khan Jee shop' | escape }}">
          {%- else -%}
            <img src="{{ section.settings.asset_file | asset_url }}"
                 width="1600" height="1067" loading="lazy" decoding="async"
                 alt="{{ section.settings.image_alt | default: 'A customer being measured in the Khan Jee shop' | escape }}">
          {%- endif -%}
        </figure>
      {%- endif -%}

      <div class="lada__measure-act">
        <a class="btn-lada" href="https://wa.me/{{ wa }}?text={{ wa_text | url_encode }}"
           target="_blank" rel="noopener">
          {{ section.settings.cta_label | default: 'Send your measurements on WhatsApp' }}</a>
        <a class="lada__link" href="{{ section.settings.secondary_url | default: '#lada-house' }}">
          {{ section.settings.secondary_label | default: 'Or visit the shop' }}</a>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lada measure",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "steps", "label": "Steps", "info": "Separate with | — numbering is automatic" },
    { "type": "header", "content": "Lead time" },
    { "type": "text", "id": "lead1_label", "label": "Line 1 label" },
    { "type": "text", "id": "lead1_value", "label": "Line 1 value" },
    { "type": "text", "id": "lead2_label", "label": "Line 2 label" },
    { "type": "text", "id": "lead2_value", "label": "Line 2 value" },
    { "type": "header", "content": "Photograph" },
    { "type": "paragraph", "content": "Landscape. Someone being measured in the shop. Leave empty until the shoot — the copy runs full width without it." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "asset_file", "label": "…or theme asset filename" },
    { "type": "text", "id": "image_alt", "label": "Alt text", "info": "Used with the asset filename only" },
    { "type": "header", "content": "Routes" },
    { "type": "text", "id": "cta_label", "label": "Primary button" },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp number", "default": "923019090590" },
    { "type": "textarea", "id": "whatsapp_text", "label": "Pre-filled message" },
    { "type": "text", "id": "secondary_label", "label": "Secondary link" },
    { "type": "url", "id": "secondary_url", "label": "Secondary link URL" }
  ],
  "presets": [{ "name": "Lada measure" }]
}
{% endschema %}
