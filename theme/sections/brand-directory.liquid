{%- comment -%}
  sections/brand-directory.liquid
  The full approved directory, for /pages/brands. Grouped by department.
{%- endcomment -%}

{%- liquid
  assign gents = 'Dynasty,Pasha,Grace,Narkins,Shabbir,Shaffer,Sitara,Stallers,Chawla,Ghani & Sons,Ghazi Ilamdin,Bin Saeed,Barooque,Laaj,Puri,Rashid' | split: ','
  assign ladies = 'Alkaram,Asim Jofa,Crimson,Gulaal,Maria B,Bin Ilyas,Charizma,Glamour,Elan,Gul Ahmad,Emaan Adeel,Emblish,Khoobsoorat,Mushq,Noor,Zellbury,Rang Rasia,Ramshah,Razab,Sara,Lakhanee,Nur,Raessa,Sirine,Seren,Florent,Izinek,Jhora,Columkari' | split: ','
  assign bridal = 'Ayla Zahra,Zahra Shahjahan,Sobia Nazir,Shiza Hassan,Saira Rizwan,Saira Shakira,Sadia Noor,Sanum Saeed,Noor by Sadia,Noor e Fajar,Hussain Rehar,Rajbari,Shahista,Parishy,Zebtan' | split: ','
  assign logo_map = 'dynasty:dynasty.svg,pasha:pasha.png,grace:grace.png,narkins:narkins.png,maria-b:maria-b.svg,zellbury:zellbury.png,saira-shakira:saira-shakira.png,shahista:shaista.webp' | split: ','
-%}

<div class="wrap">
  <div class="phead" style="text-align:center">
    <h1 class="ptitle">{{ section.settings.heading | default: 'All brands under one roof' }}</h1>
    <p class="psub" style="margin-inline:auto">{{ section.settings.sub }}</p>
  </div>

  {%- for group in (1..3) -%}
    {%- liquid
      case group
        when 1
          assign list = gents
          assign label = 'Gents'
          assign prefix = 'gents-'
        when 2
          assign list = ladies
          assign label = 'Ladies'
          assign prefix = 'ladies-'
        when 3
          assign list = bridal
          assign label = 'Bridal & Formal'
          assign prefix = 'bridal-'
      endcase
    -%}
    <section class="bdir">
      <h2 class="bdir__h">{{ label }} &middot; {{ list.size }} houses</h2>
      <div class="bdir__grid">
        {%- for brand in list -%}
          {%- liquid
            assign name = brand | strip
            assign handle = name | handleize
            assign logo_file = ''
            for pair in logo_map
              assign kv = pair | split: ':'
              if kv[0] == handle
                assign logo_file = kv[1]
              endif
            endfor
          -%}
          <a class="bdir__cell" href="{{ routes.collections_url }}/{{ prefix }}{{ handle }}">
            {%- if logo_file != '' -%}
              <img src="{{ logo_file | asset_url }}" alt="{{ name | escape }}"
                   loading="lazy" decoding="async" width="150" height="40">
            {%- else -%}
              <span>{{ name }}</span>
            {%- endif -%}
          </a>
        {%- endfor -%}
      </div>
    </section>
  {%- endfor -%}
  <section class="bdir">
    <h2 class="bdir__h">Shop by fabric</h2>
    <div class="bdir__fab">
      <h3 class="bdir__fabh">Gents</h3>
      <div class="chiprow" role="list">
        <a class="chip" href="{{ routes.collections_url }}/gents-fabric-shirting">Shirting</a>
        <a class="chip" href="{{ routes.collections_url }}/gents-fabric-khaddar">Khaddar</a>
        <a class="chip" href="{{ routes.collections_url }}/gents-fabric-boski">Boski</a>
        <a class="chip" href="{{ routes.collections_url }}/gents-fabric-cotton">Cotton</a>
        <a class="chip" href="{{ routes.collections_url }}/gents-fabric-wash-wear">Wash &amp; Wear</a>
        <a class="chip" href="{{ routes.collections_url }}/gents-fabric-wool">Wool &amp; Winter</a>
        <a class="chip" href="{{ routes.collections_url }}/gents-fabric-premium-suiting">Premium Suiting</a>
        <a class="chip" href="{{ routes.collections_url }}/gents-silk">Gents Silk</a>
        <a class="chip" href="{{ routes.collections_url }}/gents-fabric-shawls">Shawls</a>
      </div>
      <h3 class="bdir__fabh">Ladies</h3>
      <div class="chiprow" role="list">
        <a class="chip" href="{{ routes.collections_url }}/ladies-fabric-lawn">Lawn</a>
        <a class="chip" href="{{ routes.collections_url }}/ladies-fabric-khaddar">Khaddar</a>
        <a class="chip" href="{{ routes.collections_url }}/ladies-fabric-cambric">Cambric</a>
        <a class="chip" href="{{ routes.collections_url }}/ladies-fabric-chiffon">Chiffon</a>
        <a class="chip" href="{{ routes.collections_url }}/ladies-fabric-karandi">Karandi</a>
        <a class="chip" href="{{ routes.collections_url }}/ladies-fabric-jacquard">Jacquard</a>
        <a class="chip" href="{{ routes.collections_url }}/ladies-fabric-organza">Organza</a>
        <a class="chip" href="{{ routes.collections_url }}/ladies-fabric-velvet">Velvet</a>
        <a class="chip" href="{{ routes.collections_url }}/ladies-fabric-net">Net</a>
        <a class="chip" href="{{ routes.collections_url }}/ladies-fabric-abaya">Abaya</a>
      </div>
    </div>
  </section>

  <section class="bdir bdir--own">
    <h2 class="bdir__h">Our own label</h2>
    <a class="bdir__cell bdir__cell--lada" href="{{ routes.root_url }}pages/lada"><span>Lada by Khan Jee</span></a>
  </section>
</div>

{% schema %}
{
  "name": "Brand directory",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "All brands under one roof" },
    { "type": "textarea", "id": "sub", "label": "Subtitle",
      "default": "Every house Khan Jee stocks, and our own label. Cloth is sold by the metre or as full unstitched suits." }
  ]
}
{% endschema %}
