{%- comment -%}
  sections/brand-directory.liquid
  The full approved directory, for /pages/brands. Grouped by department.
{%- endcomment -%}

{%- liquid
  assign gents = 'Dynasty,Pasha,Grace,Narkins,Shabbir,Shaffer,Sitara,Stallers,Chawla,Ghani & Sons,Ghazi Ilamdin,Bin Saeed,Barooque,Laaj,Puri,Rashid' | split: ','
  assign ladies = 'Alkaram,Asim Jofa,Crimson,Gulaal,Maria B,Bin Ilyas,Charizma,Glamour,Elan,Gul Ahmad,Emaan Adeel,Emblish,Khoobsoorat,Mushq,Noor,Zellbury,Rang Rasia,Ramshah,Razab,Sara,Lakhanee,Nur,Raessa,Sirine,Seren,Florent,Izinek,Jhora,Columkari' | split: ','
  assign bridal = 'Ayla Zahra,Zahra Shahjahan,Sobia Nazir,Shiza Hassan,Saira Rizwan,Saira Shakira,Sadia Noor,Sanum Saeed,Noor by Sadia,Noor e Fajar,Hussain Rehar,Rajbari,Shahista,Parishy,Zebtan' | split: ','
  assign logo_map = 'alkaram:alkaram.png,asim-jofa:asim-jofa.png,ayla-zahra:ayla-zahra.png,bin-ilyas:bin-ilyas.png,bin-saeed:bin-saeed.png,charizma:charizma.svg,chawla:chawla.png,crimson:crimson.png,dynasty:dynasty.svg,elan:elan.png,emaan-adeel:emaan-adeel.png,florent:florent.png,ghani-sons:ghani-sons.png,grace:grace.png,gul-ahmad:gul-ahmad.png,gulaal:gulaal.png,hussain-rehar:hussain-rehar.png,izinek:izinek.png,jhora:jhora.png,lakhanee:lakhanee.png,maria-b:maria-b.svg,mushq:mushq.png,narkins:narkins.png,noor:noor.png,noor-e-fajar:noor-e-fajar.png,nur:nur.png,parishy:parishy.png,pasha:pasha.png,puri:puri.png,raessa:raessa.png,rajbari:rajbari.png,ramshah:ramshah.png,rang-rasia:rang-rasia.png,rashid:rashid.png,razab:razab.jpg,saira-rizwan:saira-rizwan.png,saira-shakira:saira-shakira.png,shabbir:shabbir.png,shaffer:shaffer.png,shahista:shaista.webp,sitara:sitara.jpg,sobia-nazir:sobia-nazir.png,zahra-shahjahan:zahra-shahjahan.png,zebtan:zebtan.png,zellbury:zellbury.png' | split: ','
-%}

<div class="wrap">
  <div class="phead" style="text-align:center">
    <h1 class="ptitle">{{ section.settings.heading | default: 'All brands under one roof' }}</h1>
    <p class="psub" style="margin-inline:auto">{{ section.settings.sub }}</p>
  </div>

  {%- for group in (1..3) -%}
    {%- liquid
      case group
        when 1
          assign list = gents
          assign label = 'Gents'
          assign prefix = 'gents-'
          assign fallback_handle = 'gents-unstitched'
        when 2
          assign list = ladies
          assign label = 'Ladies'
          assign prefix = 'ladies-'
          assign fallback_handle = 'ladies-unstitched'
        when 3
          assign list = bridal
          assign label = 'Bridal & Formal'
          assign prefix = 'bridal-'
          assign fallback_handle = 'bridal'
      endcase
    -%}
    <section class="bdir">
      <h2 class="bdir__h">{{ label }} &middot; {{ list.size }} houses</h2>
      <div class="bdir__grid">
        {%- for brand in list -%}
          {%- liquid
            assign name = brand | strip
            assign handle = name | handleize
            assign logo_file = ''
            for pair in logo_map
              assign kv = pair | split: ':'
              if kv[0] == handle
                assign logo_file = kv[1]
              endif
            endfor
            assign brand_handle = prefix | append: handle
          -%}
          {%- comment -%}
            Same resolution as the brand strip: a cell points at the
            brand's own collection once that exists, and at the gender
            collection until then, rather than at a 404.
          {%- endcomment -%}
          {%- capture cell_url -%}
            {%- render 'kj-collection-url', handle: brand_handle, fallback: fallback_handle, vendor: name -%}
          {%- endcapture -%}
          <a class="bdir__cell" href="{{ cell_url | strip }}">
            {%- if logo_file != '' -%}
              <img src="{{ logo_file | asset_url }}" alt="{{ name | escape }}"
                   loading="lazy" decoding="async" width="150" height="40">
            {%- else -%}
              <span>{{ name }}</span>
            {%- endif -%}
          </a>
        {%- endfor -%}
      </div>
    </section>
  {%- endfor -%}
  <section class="bdir">
    <h2 class="bdir__h">Shop by fabric</h2>
    <div class="bdir__fab">
      <h3 class="bdir__fabh">Gents</h3>
      <div class="chiprow" role="list">
        {%- capture u -%}{%- render 'kj-collection-url', handle: 'gents-fabric-shirting', fallback: 'gents-unstitched' -%}{%- endcapture -%}<a class="chip" href="{{ u | strip }}">Shirting</a>
        {%- capture u -%}{%- render 'kj-collection-url', handle: 'gents-fabric-khaddar', fallback: 'gents-unstitched' -%}{%- endcapture -%}<a class="chip" href="{{ u | strip }}">Khaddar</a>
        {%- capture u -%}{%- render 'kj-collection-url', handle: 'gents-fabric-boski', fallback: 'gents-unstitched' -%}{%- endcapture -%}<a class="chip" href="{{ u | strip }}">Boski</a>
        {%- capture u -%}{%- render 'kj-collection-url', handle: 'gents-fabric-cotton', fallback: 'gents-unstitched' -%}{%- endcapture -%}<a class="chip" href="{{ u | strip }}">Cotton</a>
        {%- capture u -%}{%- render 'kj-collection-url', handle: 'gents-fabric-wash-wear', fallback: 'gents-unstitched' -%}{%- endcapture -%}<a class="chip" href="{{ u | strip }}">Wash &amp; Wear</a>
        {%- capture u -%}{%- render 'kj-collection-url', handle: 'gents-fabric-wool', fallback: 'gents-unstitched' -%}{%- endcapture -%}<a class="chip" href="{{ u | strip }}">Wool &amp; Winter</a>
        {%- capture u -%}{%- render 'kj-collection-url', handle: 'gents-fabric-premium-suiting', fallback: 'gents-unstitched' -%}{%- endcapture -%}<a class="chip" href="{{ u | strip }}">Premium Suiting</a>
        {%- capture u -%}{%- render 'kj-collection-url', handle: 'gents-silk', fallback: 'gents-unstitched' -%}{%- endcapture -%}<a class="chip" href="{{ u | strip }}">Gents Silk</a>
        {%- capture u -%}{%- render 'kj-collection-url', handle: 'gents-fabric-shawls', fallback: 'gents-unstitched' -%}{%- endcapture -%}<a class="chip" href="{{ u | strip }}">Shawls</a>
      </div>
      <h3 class="bdir__fabh">Ladies</h3>
      <div class="chiprow" role="list">
        {%- capture u -%}{%- render 'kj-collection-url', handle: 'ladies-fabric-lawn', fallback: 'ladies-unstitched' -%}{%- endcapture -%}<a class="chip" href="{{ u | strip }}">Lawn</a>
        {%- capture u -%}{%- render 'kj-collection-url', handle: 'ladies-fabric-khaddar', fallback: 'ladies-unstitched' -%}{%- endcapture -%}<a class="chip" href="{{ u | strip }}">Khaddar</a>
        {%- capture u -%}{%- render 'kj-collection-url', handle: 'ladies-fabric-cambric', fallback: 'ladies-unstitched' -%}{%- endcapture -%}<a class="chip" href="{{ u | strip }}">Cambric</a>
        {%- capture u -%}{%- render 'kj-collection-url', handle: 'ladies-fabric-chiffon', fallback: 'ladies-unstitched' -%}{%- endcapture -%}<a class="chip" href="{{ u | strip }}">Chiffon</a>
        {%- capture u -%}{%- render 'kj-collection-url', handle: 'ladies-fabric-karandi', fallback: 'ladies-unstitched' -%}{%- endcapture -%}<a class="chip" href="{{ u | strip }}">Karandi</a>
        {%- capture u -%}{%- render 'kj-collection-url', handle: 'ladies-fabric-jacquard', fallback: 'ladies-unstitched' -%}{%- endcapture -%}<a class="chip" href="{{ u | strip }}">Jacquard</a>
        {%- capture u -%}{%- render 'kj-collection-url', handle: 'ladies-fabric-organza', fallback: 'ladies-unstitched' -%}{%- endcapture -%}<a class="chip" href="{{ u | strip }}">Organza</a>
        {%- capture u -%}{%- render 'kj-collection-url', handle: 'ladies-fabric-velvet', fallback: 'ladies-unstitched' -%}{%- endcapture -%}<a class="chip" href="{{ u | strip }}">Velvet</a>
        {%- capture u -%}{%- render 'kj-collection-url', handle: 'ladies-fabric-net', fallback: 'ladies-unstitched' -%}{%- endcapture -%}<a class="chip" href="{{ u | strip }}">Net</a>
        {%- capture u -%}{%- render 'kj-collection-url', handle: 'ladies-fabric-abaya', fallback: 'ladies-unstitched' -%}{%- endcapture -%}<a class="chip" href="{{ u | strip }}">Abaya</a>
      </div>
    </div>
  </section>

  <section class="bdir bdir--own">
    <h2 class="bdir__h">Our own label</h2>
    <a class="bdir__cell bdir__cell--lada" href="{{ routes.root_url }}pages/lada"><span>Lada by Khan Jee</span></a>
  </section>
</div>

{% schema %}
{
  "name": "Brand directory",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "All brands under one roof" },
    { "type": "textarea", "id": "sub", "label": "Subtitle",
      "default": "Every house Khan Jee stocks, and our own label. Cloth is sold by the metre or as full unstitched suits." }
  ]
}
{% endschema %}
