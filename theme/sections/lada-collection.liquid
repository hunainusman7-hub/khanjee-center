{%- comment -%}
  sections/lada-collection.liquid

  The range, promoted to the third thing you see, as a silent wall of
  photographs.

  What was removed and why. The old version was a heading, a .pgrid and
  the shared product card. .pgrid runs gap var(--s6) var(--s4), a 2:1
  vertical-to-horizontal ratio that reads as a catalogue table: rows
  butt up against each other and the eye scans down columns. The grid
  below runs column-gap var(--s4) against row-gap var(--s8), roughly
  4:1, so each row reads as its own spread. That single number is the
  difference between a stock list and a lookbook.

  What is deliberately absent. No filter rail, no sort dropdown, no
  result count. At five to thirteen pieces a facet drawer is furniture
  pretending to be depth, and a result count on a range this size only
  tells the customer how small it is. Revisit above roughly 30 pieces,
  and then build an inline rail that reflows the grid rather than a
  drawer that covers it.

  The pills are blocks, not a hard-coded list, because the client adds
  and reorders sub-categories himself once the range grows. A pill with
  no destination set is not a broken link: it renders as plain text
  rather than a dead <a href="">.

  Only the FIRST destination-less pill is the current view. The earlier
  pass marked EVERY destination-less pill aria-current, and the preset
  ships four of them with no links on them at all, so a fresh install
  painted all four champagne and announced four "current" items in one
  nav. That is the state the client sees the first minute he adds this
  section, so it is the state that had to be right. First one is "All"
  by convention and reads as where you are standing; the rest are inert
  until he wires them, drawn quiet so a pill that cannot be clicked
  never offers a hover.

  The whole row is skipped unless at least one block has a label, since
  a <nav> of nothing is an empty landmark and a scroll container with
  no content in it is a stray gap under the heading.

  There are currently ZERO products in the Lada collection, so the
  empty state is the state this section ships in. It is written for
  garments rather than the cloth copy it inherited, and it keeps the
  WhatsApp reserve route, which is the only route this funnel has.
{%- endcomment -%}

{%- liquid
  assign coll = collections[section.settings.collection]

  assign has_products = false
  if coll != blank and coll.products.size > 0
    assign has_products = true
  endif

  assign wa      = section.settings.whatsapp | default: '923019090590'
  assign wa_text = section.settings.whatsapp_text | default: 'I would like to reserve a Lada waistcoat.'

  # Card strings live here rather than in the snippet so the client
  # edits them once for the whole grid instead of once per product.
  assign mtm_tag       = section.settings.mtm_tag       | default: 'made-to-measure'
  assign mtm_label     = section.settings.mtm_label     | default: 'Measured in the shop'
  assign mtm_url       = section.settings.mtm_url       | default: '#lada-measure'
  assign add_label     = section.settings.add_label     | default: 'Add to bag'
  assign options_label = section.settings.options_label | default: 'Choose options'
  assign sold_label    = section.settings.sold_label    | default: 'Sold out'
  assign divider       = section.settings.divider       | default: '|'

  # The empty-state plate is optional on purpose. Exactly one Lada
  # photograph exists today, so this section has to look finished with
  # no image in it at all. With nothing picked the panel is copy inside
  # a hairline box, which is a deliberate object; with an image it
  # becomes a plate with copy under it. Neither state has a hole in it.
  assign has_plate = false
  if section.settings.empty_image != blank or section.settings.empty_asset != blank
    assign has_plate = true
  endif

  # A block whose label the client cleared prints nothing, so blocks.size
  # is not the same question as "is there a pill row". Ask the real one
  # before opening the <nav>.
  assign pills_any = false
  for block in section.blocks
    if block.settings.label != blank
      assign pills_any = true
    endif
  endfor
-%}

<section class="lada" id="lada-collection" aria-labelledby="lada-collection-h">
  <div class="lada__wrap lada__sec">
    <p class="lada__kicker">{{ section.settings.kicker | default: 'The range' }}</p>
    <h2 class="lada__h2" id="lada-collection-h">{{ section.settings.heading | default: 'Waistcoats and coats' }}</h2>

    {%- if pills_any -%}
      <nav class="lada__pills" aria-label="{{ section.settings.pills_label | default: 'Sub categories' | escape }}">
        {%- assign pills_shown = 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign label = block.settings.label
            assign pill_url = block.settings.link_url
            if pill_url == blank
              assign pc = block.settings.link_collection
              if pc != blank and pc.url != blank
                assign pill_url = pc.url
                if block.settings.tag != blank
                  assign pill_tag = block.settings.tag | handleize
                  assign pill_url = pc.url | append: '/' | append: pill_tag
                endif
              endif
            endif
            assign pill_here = false
            assign pill_path = pill_url | split: '?' | first
            if pill_path != blank and pill_path == request.path
              assign pill_here = true
            endif
          -%}
          {%- if label != blank -%}
            {%- assign pills_shown = pills_shown | plus: 1 -%}
            {%- if pill_url == blank -%}
              {%- comment -%}
                No destination. The first one is the view you are already
                standing in, so it is marked current and painted; a dead
                <a href=""> would reload the page, a span cannot. Every
                later unwired pill is inert: same hairline box, muted
                text, no hover fill, because a box that lights up under
                the cursor and then does nothing is a worse answer than
                a box that plainly is not ready yet.
              {%- endcomment -%}
              {%- if pills_shown == 1 -%}
                <span class="lada__pill" aria-current="page" {{ block.shopify_attributes }}>{{ label }}</span>
              {%- else -%}
                <span class="lada__pill lada__pill--inert" {{ block.shopify_attributes }}>{{ label }}</span>
              {%- endif -%}
            {%- else -%}
              <a class="lada__pill" href="{{ pill_url }}"{% if pill_here %} aria-current="page"{% endif %} {{ block.shopify_attributes }}>{{ label }}</a>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </nav>
    {%- endif -%}

    {%- if has_products -%}
      <div class="lada__grid">
        {%- for product in coll.products limit: section.settings.count -%}
          {% render 'lada-product-card',
             product: product,
             index: forloop.index0,
             mtm_tag: mtm_tag,
             mtm_label: mtm_label,
             mtm_url: mtm_url,
             add_label: add_label,
             options_label: options_label,
             sold_label: sold_label,
             divider: divider %}
        {%- endfor -%}
      </div>

      {%- if section.settings.more_url != blank -%}
        <p class="lada__grid-more">
          <a class="lada__link" href="{{ section.settings.more_url }}">{{ section.settings.more_label | default: 'The full range' }}</a>
        </p>
      {%- endif -%}

    {%- else -%}
      <div class="lada__empty">
        {%- if has_plate -%}
          <figure class="lada__empty-plate">
            {%- if section.settings.empty_image != blank -%}
              {%- liquid
                assign pw = section.settings.empty_image.width
                if pw > 1600
                  assign pw = 1600
                endif
              -%}
              <img src="{{ section.settings.empty_image | image_url: width: pw }}"
                   srcset="{%- if pw > 700 %}{{ section.settings.empty_image | image_url: width: 700 }} 700w, {% endif -%}
                           {%- if pw > 1100 %}{{ section.settings.empty_image | image_url: width: 1100 }} 1100w, {% endif -%}
                           {{ section.settings.empty_image | image_url: width: pw }} {{ pw }}w"
                   sizes="(min-width:1180px) 1050px, 90vw"
                   width="{{ section.settings.empty_image.width }}" height="{{ section.settings.empty_image.height }}"
                   loading="lazy" decoding="async"
                   alt="{{ section.settings.empty_image.alt | default: section.settings.empty_alt | default: 'A Lada waistcoat on the cutting table' | escape }}">
            {%- else -%}
              <img src="{{ section.settings.empty_asset | asset_url }}"
                   width="1600" height="900" loading="lazy" decoding="async"
                   alt="{{ section.settings.empty_alt | default: 'A Lada waistcoat on the cutting table' | escape }}">
            {%- endif -%}
          </figure>
        {%- endif -%}

        <h3 class="lada__empty-h">{{ section.settings.empty_title | default: 'Being cut now' }}</h3>
        <p class="lada__empty-p">{{ section.settings.empty_text | default: 'The first Lada waistcoats and prince coats are on the table in our own workshop. Tell us the size and the cloth you want, and we will hold the first piece that comes off it for you.' }}</p>

        <div class="lada__empty-act">
          <a class="btn-lada" href="https://wa.me/{{ wa }}?text={{ wa_text | url_encode }}"
             target="_blank" rel="noopener">{{ section.settings.empty_cta | default: 'Reserve on WhatsApp' }}</a>
          <a class="lada__link" href="{{ section.settings.empty_link_url | default: '#lada-measure' }}">{{ section.settings.empty_link_label | default: 'Or be measured in the shop' }}</a>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Lada collection",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The range" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Waistcoats and coats" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "count", "min": 2, "max": 16, "step": 1, "label": "Pieces shown", "default": 8 },
    { "type": "text", "id": "pills_label", "label": "Pill row label", "default": "Sub categories", "info": "Read out by screen readers only. Not shown on the page." },
    { "type": "header", "content": "Card labels" },
    { "type": "paragraph", "content": "These apply to every card in the grid. The cloth and cut shown on a card come from that product's own fields." },
    { "type": "text", "id": "divider", "label": "Cloth and cut divider", "default": "|" },
    { "type": "text", "id": "add_label", "label": "Add button", "default": "Add to bag" },
    { "type": "text", "id": "options_label", "label": "Choose options button", "default": "Choose options" },
    { "type": "text", "id": "sold_label", "label": "Sold out label", "default": "Sold out" },
    { "type": "header", "content": "Made to measure" },
    { "type": "paragraph", "content": "A piece tagged with the tag below shows the label instead of a price, linking to the measuring section." },
    { "type": "text", "id": "mtm_tag", "label": "Product tag", "default": "made-to-measure" },
    { "type": "text", "id": "mtm_label", "label": "Shown instead of the price", "default": "Measured in the shop" },
    { "type": "text", "id": "mtm_url", "label": "Links to", "default": "#lada-measure" },
    { "type": "header", "content": "Below the grid" },
    { "type": "text", "id": "more_label", "label": "Link label", "default": "The full range" },
    { "type": "url", "id": "more_url", "label": "Link URL", "info": "Leave empty to hide the link." },
    { "type": "header", "content": "Empty state" },
    { "type": "paragraph", "content": "Shown while the collection has no products in it. It is written to look finished with no photograph, so leave the plate empty until the shoot." },
    { "type": "image_picker", "id": "empty_image", "label": "Plate" },
    { "type": "text", "id": "empty_asset", "label": "...or theme asset filename" },
    { "type": "text", "id": "empty_alt", "label": "Alt text", "info": "Used with the asset filename only." },
    { "type": "text", "id": "empty_title", "label": "Title", "default": "Being cut now" },
    { "type": "textarea", "id": "empty_text", "label": "Text", "default": "The first Lada waistcoats and prince coats are on the table in our own workshop. Tell us the size and the cloth you want, and we will hold the first piece that comes off it for you." },
    { "type": "text", "id": "empty_cta", "label": "Button", "default": "Reserve on WhatsApp" },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp number", "default": "923019090590" },
    { "type": "textarea", "id": "whatsapp_text", "label": "Pre-filled message", "default": "I would like to reserve a Lada waistcoat." },
    { "type": "text", "id": "empty_link_label", "label": "Secondary link", "default": "Or be measured in the shop" },
    { "type": "text", "id": "empty_link_url", "label": "Secondary link URL", "default": "#lada-measure" }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Sub category pill",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Waistcoats" },
        { "type": "paragraph", "content": "Pick a collection, and optionally a tag inside it. Or paste a URL, which wins over both. Leave all three empty and the pill reads as the view you are already in." },
        { "type": "collection", "id": "link_collection", "label": "Collection" },
        { "type": "text", "id": "tag", "label": "Tag inside that collection" },
        { "type": "url", "id": "link_url", "label": "Or a URL" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Lada collection",
      "blocks": [
        { "type": "pill", "settings": { "label": "All" } },
        { "type": "pill", "settings": { "label": "Waistcoats" } },
        { "type": "pill", "settings": { "label": "Prince coats" } },
        { "type": "pill", "settings": { "label": "Made to measure" } }
      ]
    }
  ]
}
{% endschema %}
