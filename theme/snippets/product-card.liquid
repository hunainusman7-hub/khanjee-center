{%- comment -%}
  snippets/product-card.liquid
  Usage: {% render 'product-card', product: product, index: forloop.index0 %}
  Optional: card_sizes, a `sizes` string for callers whose slot is not a
  .pgrid cell. sections/product-carousel.liquid passes the rail's own clamp.

  Hover swaps to the product's second image. Falls back gracefully to a
  single image, and on touch devices the swap fires on first tap
  (see kj-v2.js) instead of blocking the link.

  Naming rule: only Dynasty and Pasha are sold under their own cloth name.
  Everything else is a Khan Jee piece and shows its KJC SKU instead of a
  supplier name — so `vendor` is only surfaced for those two houses.
{%- endcomment -%}

{%- liquid
  assign alt_media = null
  if product.media.size > 1
    assign alt_media = product.media[1]
  endif

  assign sku = product.selected_or_first_available_variant.sku
  assign fabric = product.metafields.custom.by_fabric.value
  assign pieces = product.metafields.custom.by_pieces.value
  assign in_house = product.metafields.lada.in_house.value
  assign preorder = product.metafields.custom.preorder.value

  assign named_houses = 'Dynasty,Pasha' | split: ','
  assign show_vendor = false
  for house in named_houses
    if product.vendor == house
      assign show_vendor = true
    endif
  endfor

  assign loading = 'lazy'
  if index < 4
    assign loading = 'eager'
  endif

  # Never ask the CDN for a width the source file does not have. An upscale
  # request hands back the native file anyway, but it writes a candidate the
  # browser may pick on a 3x screen and then render soft. The native width is
  # always the last candidate and the smaller steps are only written when the
  # source actually clears them. Same rule as snippets/lada-product-card.
  assign main_w = product.featured_media.width | default: 800
  assign main_src_w = 800
  if main_w < main_src_w
    assign main_src_w = main_w
  endif
  assign alt_w = alt_media.width | default: 800
  assign alt_src_w = 800
  if alt_w < alt_src_w
    assign alt_src_w = alt_w
  endif

  # The slot depends on who rendered the card. The default is a .pgrid cell
  # on a collection page; the homepage rail is a fixed clamp that is a quarter
  # wider than that on a phone, so the carousel hands its own string in rather
  # than letting every card there download a file too small for its box.
  assign slot = card_sizes | default: '(min-width:1100px) 24vw, (min-width:760px) 32vw, 46vw'

  assign off = 0
  if product.compare_at_price > product.price
    assign off = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
  endif
-%}

<article class="pcard" data-pcard>
  {%- comment -%}
    Quick add is positioned against THIS box, not against the card.
    .pcard is position:relative and the form used to be a direct child of
    it, so `bottom` resolved to the bottom of the whole card — the button
    popped up over the title and the price instead of over the bottom of
    the photograph. This wrapper is what gives it something to sit on.
  {%- endcomment -%}
  <div class="pcard__top">
  <a class="pcard__media pcard__link" href="{{ product.url }}"
     tabindex="-1" aria-hidden="true">
    {%- if product.featured_media -%}
      <img class="pcard__img pcard__img--main"
           src="{{ product.featured_media | image_url: width: main_src_w }}"
           srcset="{%- if main_w > 400 %}{{ product.featured_media | image_url: width: 400 }} 400w, {% endif -%}
                   {%- if main_w > 800 %}{{ product.featured_media | image_url: width: 800 }} 800w, {% endif -%}
                   {%- if main_w > 1200 %}{{ product.featured_media | image_url: width: 1200 }} 1200w, {% endif -%}
                   {{ product.featured_media | image_url: width: main_w }} {{ main_w }}w"
           sizes="{{ slot }}"
           width="{{ product.featured_media.width }}" height="{{ product.featured_media.height }}"
           loading="{{ loading }}" decoding="async"
           alt="{{ product.featured_media.alt | default: product.title | escape }}">
    {%- else -%}
      <span class="pcard__img pcard__img--main" aria-hidden="true"></span>
    {%- endif -%}

    {%- if alt_media -%}
      <img class="pcard__img pcard__img--alt"
           src="{{ alt_media | image_url: width: alt_src_w }}"
           srcset="{%- if alt_w > 400 %}{{ alt_media | image_url: width: 400 }} 400w, {% endif -%}
                   {%- if alt_w > 800 %}{{ alt_media | image_url: width: 800 }} 800w, {% endif -%}
                   {{ alt_media | image_url: width: alt_w }} {{ alt_w }}w"
           sizes="{{ slot }}"
           width="{{ alt_media.width }}" height="{{ alt_media.height }}"
           loading="lazy" decoding="async" aria-hidden="true"
           alt="">
    {%- endif -%}

    {%- if product.compare_at_price > product.price -%}
      <span class="pcard__off">{{ off }}% OFF</span>
    {%- elsif in_house -%}
      <span class="pcard__badge pcard__badge--seal">Khan Jee Seal</span>
    {%- elsif product.available == false and preorder -%}
      <span class="pcard__pre">Pre order</span>
    {%- endif -%}

    {%- unless product.available -%}
      <span class="pcard__soldout">Sold out</span>
    {%- endunless -%}
  </a>

  {%- comment -%}
    Quick add. Unstitched cloth has no variants, so a card can add
    straight to the bag; anything with real options has to go through
    the product page, where the options actually exist.

    data-kj-atc hands the submit to kj-cart.js, which posts to
    /cart/add.js and opens the bag. Without JS this is still a plain
    form post to /cart/add and still works.
  {%- endcomment -%}
  {%- if product.available and product.variants.size == 1 -%}
    <form class="pcard__add" action="{{ routes.cart_add_url }}" method="post"
          enctype="multipart/form-data" data-kj-atc>
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      <input type="hidden" name="quantity" value="1">
      <button type="submit" class="pcard__quick">
        <span class="pcard__quick-t">Add to bag</span>
        <span class="pcard__spin" aria-hidden="true"></span>
      </button>
      <p class="pcard__err" data-kj-atc-error role="alert" hidden></p>
    </form>
  {%- elsif product.available -%}
    <a class="pcard__quick pcard__quick--link" href="{{ product.url }}">Choose options</a>
  {%- endif -%}
  </div>

  {%- comment -%}
    The title is the link people actually aim for, so it is a real one.
    The image link above is marked decorative rather than adding a second
    link to the same product, which would make every card announce itself
    twice and double the tab stops in a grid.
  {%- endcomment -%}
  <h3 class="pcard__title">
    <a href="{{ product.url }}">{{ product.title | split: ' - ' | first }}</a>
  </h3>

  {%- comment -%}
    Every badge above sits inside .pcard__link, and that anchor is
    aria-hidden, so a screen reader was never told a piece is sold out, cut
    in price, sealed or on pre-order. The badges cannot simply move out:
    each one is positioned against the photograph, which is that anchor.
    So the same facts are repeated here as plain text in the reading order,
    right after the name they belong to. The branches mirror the badge
    branches exactly, so the two can never say different things.
  {%- endcomment -%}
  {%- capture card_status -%}
    {%- if product.compare_at_price > product.price -%}
      {{ off }}% off.
    {%- elsif in_house -%}
      Khan Jee Seal.
    {%- elsif product.available == false and preorder -%}
      Available to pre order.
    {%- endif -%}
    {%- unless product.available %} Sold out.{% endunless -%}
  {%- endcapture -%}
  {%- assign card_status = card_status | strip -%}
  {%- if card_status != blank -%}
    <p class="vh">{{ card_status }}</p>
  {%- endif -%}

  <p class="pcard__meta">
    {%- if show_vendor -%}
      {{ product.vendor }}
      {%- if fabric %} · {{ fabric }}{% endif -%}
    {%- elsif fabric -%}
      {{ fabric }}{% if pieces %} · {{ pieces }}{% endif %}
    {%- elsif sku -%}
      {{ sku }}
    {%- endif -%}
  </p>

  <p class="pcard__price">
    {%- if product.compare_at_price > product.price -%}
      <s><span class="vh">Was </span>{{ product.compare_at_price | money }}</s><span class="now"><span class="vh">Now </span>{{ product.price | money }}</span>
    {%- else -%}
      {{ product.price | money }}
    {%- endif -%}
  </p>
</article>
