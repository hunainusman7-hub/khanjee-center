{%- comment -%}
  snippets/lada-mark.liquid — the Lada wordmark.

  Lada is the in-house label, so it has no supplier logo to borrow. This is a
  drawn mark: the Hiran Minar arch that runs through the rest of the site,
  an L monogram inside it, and the name letterspaced beneath. Colour comes
  from currentColor so it sits on the dark Lada ground in brass, or on white
  in crimson, without a second file.

  Usage: {% render 'lada-mark' %} or {% render 'lada-mark', class: 'lada__mark--lg' %}
{%- endcomment -%}
<svg class="lada-mark{% if class %} {{ class }}{% endif %}" viewBox="0 0 200 148"
     width="200" height="148" fill="none" preserveAspectRatio="xMidYMid meet"
     role="img" aria-label="Lada, by Khan Jee">
  {%- comment -%} the arch, same silhouette as the #kj-arch clip path {%- endcomment -%}
  <path d="M100 6 C124 24 156 36 156 60 L156 96 L44 96 L44 60 C44 36 76 24 100 6 Z"
        stroke="currentColor" stroke-width="2" opacity=".55"/>
  {%- comment -%} L monogram, drawn rather than set, so it never depends on a webfont {%- endcomment -%}
  <path d="M86 40 L94 40 L94 74 L116 74 L116 82 L86 82 Z" fill="currentColor"/>
  <path d="M78 40 L102 40" stroke="currentColor" stroke-width="2"/>
  <path d="M62 112 L138 112" stroke="currentColor" stroke-width="1" opacity=".45"/>
  <text x="100" y="136" text-anchor="middle" fill="currentColor"
        font-family="Archivo, Helvetica Neue, Arial, sans-serif"
        font-size="17" font-weight="600" letter-spacing="7.5">LADA</text>
</svg>
