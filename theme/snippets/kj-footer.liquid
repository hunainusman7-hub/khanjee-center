{%- comment -%}
  snippets/kj-footer.liquid

  The shop is called Khan Jee Center everywhere a customer can read it.
  "Khan Jee Fabrics" used to appear here twice and nowhere else on the site.

  Shawls are named the way the category grid, the rail and the mega menu
  name them: Gents Shawls and Ladies Shawls, pointing at the two handles
  that actually hold stock. The single "Shawls & Wraps" row here pointed at
  /collections/shawls, which is not a collection anyone has created. The
  header's top-level Shawls link in snippets/kj-nav.liquid still points at
  that same handle and still 404s; it belongs to another file.

  The two informational pages have no template in this theme and no other
  page links to them, so they are only printed once the client has actually
  created them. A footer link to a page that does not exist is a 404 in the
  one place every page on the site shows.
{%- endcomment -%}
<footer class="foot">
  <div class="wrap">
    <div class="foot__grid">
      <div>
        <span class="foot__mark" style="display:block">{% render 'kj-mark' %}</span>
        <p class="foot__about">
          Khan Jee Center, Sheikhupura, Punjab. Unstitched cloth for men and women since 1978.</p>
        <p class="foot__tag">
          All brands under one roof</p>
      </div>
      <div><h2 class="foot__ch">Shop</h2><ul>
        <li><a href="{{ routes.root_url }}pages/lada">Lada by Khan Jee</a></li>
        <li><a href="{{ routes.root_url }}collections/gents-unstitched">Gents Unstitched</a></li>
        <li><a href="{{ routes.root_url }}collections/ladies-unstitched">Ladies Unstitched</a></li>
        <li><a href="{{ routes.root_url }}collections/gents-fabric-shawls">Gents Shawls</a></li>
        <li><a href="{{ routes.root_url }}collections/ladies-fabric-shawls">Ladies Shawls</a></li>
        <li><a href="{{ routes.root_url }}collections/bridal">Bridal &amp; Formal</a></li>
      </ul></div>
      <div><h2 class="foot__ch">Buying</h2><ul>
        <li><a href="{{ routes.root_url }}pages/size-guide">Size guide</a></li>
        {%- if pages['care'] != blank -%}
          <li><a href="{{ routes.root_url }}pages/care">Fabric care</a></li>
        {%- endif -%}
        {%- if pages['exchange-policy'] != blank -%}
          <li><a href="{{ routes.root_url }}pages/exchange-policy">Exchange policy</a></li>
        {%- endif -%}
        <li><a href="{{ routes.root_url }}pages/contact">Delivery &amp; cash on delivery</a></li>
      </ul></div>
      <div><h2 class="foot__ch">Visit</h2><ul>
        <li><a href="{{ routes.root_url }}pages/stores">Our store</a></li>
        <li><a href="{{ routes.root_url }}pages/about">About Khan Jee</a></li>
        <li><a href="{{ routes.root_url }}pages/contact">Contact</a></li>
        <li><a href="{{ routes.root_url }}pages/brands">All brands</a></li>
      </ul></div>
    </div>

    <div class="foot__trust">
      <span>Open parcel before payment</span>
      <span>Exchange within 7 days</span>
      <span>Cut to your measurement</span>
      <span>Cash on delivery</span>
    </div>

    <div class="foot__legal">
      <span>&copy; {{ 'now' | date: "%Y" }} Khan Jee Center</span>
      <span>Hiran Minar photograph by Shaguftakarim,
        <a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="license noopener" target="_blank">CC BY-SA 4.0</a></span>
    </div>
  </div>
</footer>
